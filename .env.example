# Pocket Frames - Gemini Vision Server Configuration
# NEVER commit your real .env file or API key to Git!

# Required for Live Gemini Vision Intelligence (obtain from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=

# Configurable Vision Model (e.g., gemini-1.5-flash, gemini-2.5-flash, gemini-2.0-flash)
GEMINI_MODEL=gemini-1.5-flash

# Optional: Server Port (default: 5173 for Vite dev)
PORT=5173

# Developer sticker backdoor — REQUIRED to enable sticker upload/delete/rename.
# Must be a strong, random PIN (NOT '7788'). Leave blank to disable the feature entirely.
DEV_PIN=

# Set to 'true' only in local dev environments where you want sticker mutations enabled.
# Leave unset or 'false' in production to fully disable the sticker upload endpoint.
ENABLE_STICKER_UPLOAD=false
